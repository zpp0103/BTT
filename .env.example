# BTT local-only development endpoints. Do not bind these services to 0.0.0.0.
BTT_HOST=127.0.0.1
BTT_API_PORT=8080
BTT_VITE_PORT=5173
BTT_OLLAMA_PORT=11434

# Local model provider. No API key is needed for Ollama.
BTT_AI_PROVIDER=ollama
BTT_AI_BASE_URL=http://127.0.0.1:11434
BTT_AI_MODEL=qwen2.5:1.5b

# Only needed when BTT_AI_PROVIDER=openai_compatible.
# Keep the real value in your shell or an untracked .env file.
BTT_AI_API_KEY=
